---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { formatDate, hasBody, url } from '../../lib/site';

export async function getStaticPaths() {
  const entries = await getCollection('journey', ({ data, body }) => {
    if (import.meta.env.PROD && data.draft) return false;
    return hasBody(body) || data.gallery.length > 0;
  });
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
---

<Base title={d.title} description={d.description}>
  <article class="wrap py-12 md:py-20">
    <div class="mb-6">
      <a href={url('/journey')} class="meta link text-ink-3 hover:text-accent inline-flex items-center gap-1">
        <span>&larr;</span>
        <span>Back to journey timeline</span>
      </a>
    </div>

    <header class="border-b border-rule pb-10">
      <div class="meta flex flex-wrap items-center gap-x-3 gap-y-1 text-ink-3 mb-3">
        <time datetime={d.date.toISOString()}>{formatDate(d.date)}</time>
        <span class="text-rule-strong">/</span>
        <span class="text-ink-2 font-medium">{d.category}</span>
      </div>

      <h1 class="text-2xl sm:text-3xl md:text-4xl font-medium tracking-tight text-ink leading-tight max-w-[48ch]">
        {d.title}
      </h1>

      <p class="mt-4 text-base md:text-lg text-ink-2 leading-relaxed max-w-[65ch]">
        {d.description}
      </p>

      {d.links.length > 0 && (
        <div class="mt-6 flex flex-wrap gap-4 text-[0.875rem]">
          {d.links.map((link) => (
            <a href={url(link.url)} class="link text-ink-2 hover:text-accent inline-flex items-center gap-1">
              <span>{link.label}</span>
              <span class="arrow-ne">&nearr;</span>
            </a>
          ))}
        </div>
      )}
    </header>

    {d.cover && (
      <figure class="my-10 max-w-[68ch]">
        <div class="overflow-hidden rounded-[2px] border border-rule">
          <img
            src={url(d.cover.src)}
            alt={d.cover.alt}
            loading="lazy"
            decoding="async"
            class="w-full object-cover"
          />
        </div>
        {d.cover.caption && (
          <figcaption class="meta text-ink-3 mt-2 font-serif italic">
            {d.cover.caption}
          </figcaption>
        )}
      </figure>
    )}

    {hasBody(entry.body) && (
      <div class="prose mt-10 max-w-[68ch]">
        <Content />
      </div>
    )}

    {d.gallery.length > 0 && (
      <section class="mt-16 border-t border-rule pt-10 max-w-[68ch]">
        <h2 class="text-xs uppercase tracking-wider font-mono text-ink-3 mb-6">Gallery</h2>
        <div class="grid grid-cols-1 gap-8 sm:grid-cols-2">
          {d.gallery.map((img) => (
            <figure class="space-y-2">
              <div class="overflow-hidden rounded-[2px] border border-rule">
                <img
                  src={url(img.src)}
                  alt={img.alt}
                  loading="lazy"
                  decoding="async"
                  class="w-full object-cover"
                />
              </div>
              {img.caption && (
                <figcaption class="meta text-ink-3 font-serif italic text-xs">
                  {img.caption}
                </figcaption>
              )}
            </figure>
          ))}
        </div>
      </section>
    )}
  </article>
</Base>
