---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { formatDate, readingTime, url } from '../../lib/site';

export async function getStaticPaths() {
  const entries = await getCollection('insights', ({ data }) => (import.meta.env.PROD ? !data.draft : true));
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const d = entry.data;
const mins = readingTime(entry.body);
const { Content } = await render(entry);
---

<Base title={d.title} description={d.description} type="article" publishedTime={d.date}>
  <article class="wrap py-12 md:py-20">
    <div class="mb-6">
      <a href={url('/insights')} class="meta link text-ink-3 hover:text-accent inline-flex items-center gap-1">
        <span>&larr;</span>
        <span>Back to writing index</span>
      </a>
    </div>

    <header class="border-b border-rule pb-10 max-w-[68ch]">
      <div class="meta flex flex-wrap items-center gap-x-3 gap-y-1 text-ink-3 mb-3">
        <time datetime={d.date.toISOString()}>{formatDate(d.date)}</time>
        <span class="text-rule-strong">/</span>
        <span>{mins} min read</span>
        {d.tags.length > 0 && (
          <>
            <span class="text-rule-strong">/</span>
            <div class="flex flex-wrap gap-2">
              {d.tags.map((tag) => (
                <span>#{tag}</span>
              ))}
            </div>
          </>
        )}
      </div>

      <h1 class="font-serif text-3xl sm:text-4xl md:text-5xl font-normal tracking-tight text-ink leading-[1.15]">
        {d.title}
      </h1>

      <p class="mt-4 text-base md:text-lg text-ink-2 leading-relaxed">
        {d.description}
      </p>
    </header>

    {d.cover && (
      <figure class="my-10 max-w-[68ch]">
        <div class="overflow-hidden rounded-[2px] border border-rule">
          <img
            src={url(d.cover.src)}
            alt={d.cover.alt}
            loading="lazy"
            decoding="async"
            class="w-full object-cover"
          />
        </div>
        {d.cover.caption && (
          <figcaption class="meta text-ink-3 mt-2 font-serif italic">
            {d.cover.caption}
          </figcaption>
        )}
      </figure>
    )}

    <div class="prose mt-12 max-w-[65ch]">
      <Content />
    </div>
  </article>
</Base>
