---
import Base from '../../layouts/Base.astro';
import ArticleRow from '../../components/insights/ArticleRow.astro';
import { getPage, published, url } from '../../lib/site';

const page = await getPage('insights');
const entries = await published('insights');
---

<Base title={page?.data.title || 'Insights'} description={page?.data.description}>
  <div class="wrap py-12 md:py-20">
    <header class="mb-14 border-b border-rule pb-10">
      <div class="flex flex-col gap-2 md:flex-row md:items-baseline md:justify-between">
        <h1 class="text-3xl font-medium tracking-tight text-ink md:text-4xl">
          {page?.data.title || 'Insights'}
        </h1>
        <a href={url('/rss.xml')} class="meta link text-ink-3 hover:text-accent inline-flex items-center gap-1">
          <span>RSS Feed</span>
          <span class="arrow-ne">&nearr;</span>
        </a>
      </div>
      {page?.data.intro && (
        <p class="mt-4 text-base md:text-lg text-ink-2 max-w-[65ch] leading-relaxed">
          {page.data.intro}
        </p>
      )}
    </header>

    <div class="divide-y divide-rule border-t border-rule">
      {entries.map((entry) => (
        <ArticleRow entry={entry} />
      ))}
    </div>
  </div>
</Base>
