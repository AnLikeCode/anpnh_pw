---
import Base from '../layouts/Base.astro';
import QuantumSphere from '../components/visual/QuantumSphere.astro';
import ResearchRow from '../components/research/ResearchRow.astro';
import ArticleRow from '../components/insights/ArticleRow.astro';
import { getMemoryPhotos } from '../lib/memories';
import { getCertificates } from '../lib/certificates';
import { getProfile, published, pickFeatured, url } from '../lib/site';
import { siteConfig } from '../site.config';

const profile = await getProfile();
const p = profile.data;

const allResearch = await published('research');
const featuredResearch = pickFeatured(allResearch, siteConfig.home.research);

const certificates = getCertificates();

const allInsights = await published('insights');
const featuredInsights = pickFeatured(allInsights, siteConfig.home.insights);

const allMemories = getMemoryPhotos();
const previewMemories = allMemories.slice(0, siteConfig.home.memories);
---

<Base>
  <!-- Hero: Asymmetric split with Text on left and QuantumSphere on right -->
  <section class="wrap pt-12 pb-16 md:pt-20 md:pb-24 border-b border-rule">
    <div class="grid grid-cols-1 items-center gap-10 md:grid-cols-12 md:gap-12">
      <div class="md:col-span-7 lg:col-span-7">
        <p class="meta text-accent mb-3 tracking-wide">{p.identity}</p>
        <h1 class="text-3xl font-medium tracking-tight text-ink sm:text-4xl md:text-5xl md:leading-[1.1]">
          {p.name}
        </h1>
        <p class="mt-4 text-base md:text-lg text-ink-2 leading-relaxed max-w-[48ch]">
          {p.statement}
        </p>

        <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-2 text-[0.875rem]">
          {p.links.map((link) => (
            <a href={url(link.url)} class="link text-ink-2 hover:text-ink">
              {link.label}
            </a>
          ))}
          <a href={url('/about')} class="link text-ink-2 hover:text-ink">
            About me
          </a>
        </div>
      </div>

      <div class="md:col-span-5 lg:col-span-5 flex justify-center md:justify-end">
        <div class="w-full max-w-[280px] sm:max-w-[320px] md:max-w-[360px]">
          <QuantumSphere />
        </div>
      </div>
    </div>
  </section>

  <!-- About summary -->
  <section class="wrap py-16 md:py-24 border-b border-rule">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-12 md:gap-12">
      <div class="md:col-span-4">
        <h2 class="h-section">Background</h2>
      </div>
      <div class="md:col-span-8">
        <p class="text-base md:text-lg text-ink-2 leading-relaxed max-w-[65ch]">
          {p.summary}
        </p>
        <div class="mt-6">
          <a href={url('/about')} class="meta link text-ink-3 hover:text-accent inline-flex items-center gap-1">
            <span>Read full biography and academic background</span>
            <span class="arrow">&rarr;</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Selected research -->
  <section class="wrap py-16 md:py-24 border-b border-rule">
    <div class="flex flex-col gap-2 md:flex-row md:items-baseline md:justify-between mb-8">
      <h2 class="h-section">Selected research</h2>
      <a href={url('/research')} class="meta link text-ink-3 hover:text-accent inline-flex items-center gap-1">
        <span>View all research ({allResearch.length})</span>
        <span class="arrow">&rarr;</span>
      </a>
    </div>

    <div>
      {featuredResearch.map((entry) => (
        <ResearchRow entry={entry} />
      ))}
    </div>
  </section>

  <!-- Certifications -->
  {certificates.length > 0 && (
    <section class="wrap py-16 md:py-24 border-b border-rule">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between mb-8">
        <div>
          <h2 class="h-section">Certifications</h2>
          <p class="mt-1 text-[0.875rem] text-ink-3 font-serif italic">
            Selected credentials and awards in quantum computing.
          </p>
        </div>
        <div class="flex items-center gap-3">
          <span class="meta text-ink-3 font-mono text-xs">{certificates.length} credentials</span>
          <div class="inline-flex items-center gap-1" role="group" aria-label="Scroll certificates">
            <button
              type="button"
              id="cert-scroll-prev"
              class="inline-flex h-8 w-8 items-center justify-center rounded-[2px] border border-rule bg-paper-2 font-mono text-xs text-ink-2 transition-colors hover:border-ink/40 hover:text-ink disabled:opacity-30 disabled:pointer-events-none"
              aria-label="Scroll certificates left"
            >
              &larr;
            </button>
            <button
              type="button"
              id="cert-scroll-next"
              class="inline-flex h-8 w-8 items-center justify-center rounded-[2px] border border-rule bg-paper-2 font-mono text-xs text-ink-2 transition-colors hover:border-ink/40 hover:text-ink disabled:opacity-30 disabled:pointer-events-none"
              aria-label="Scroll certificates right"
            >
              &rarr;
            </button>
          </div>
        </div>
      </div>

      <div
        id="cert-scroll-track"
        class="flex items-center gap-4 sm:gap-5 overflow-x-auto scroll-smooth py-1 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
      >
        {certificates.map((cert, index) => (
          <figure class="group shrink-0">
            <div
              class="cert-trigger cursor-zoom-in overflow-hidden rounded-[2px] border border-rule bg-paper-2 p-1.5 sm:p-2 shadow-xs transition-all duration-300 group-hover:border-ink/40 group-hover:-translate-y-0.5"
              data-cert-src={url(cert.src)}
              data-cert-alt={cert.alt}
              data-cert-index={index}
            >
              <div class="overflow-hidden rounded-[1px] bg-white">
                <img
                  src={url(cert.src)}
                  alt={cert.alt}
                  loading="lazy"
                  decoding="async"
                  class="block h-28 sm:h-32 md:h-36 w-auto object-contain transition-transform duration-500 ease-out group-hover:scale-[1.02]"
                />
              </div>
            </div>
          </figure>
        ))}
      </div>
    </section>
  )}

  <!-- What's New -->
  {p.news && p.news.length > 0 && (
    <section class="wrap py-16 md:py-24 border-b border-rule">
      <div class="flex flex-col gap-2 md:flex-row md:items-baseline md:justify-between mb-8">
        <h2 class="h-section">What's New</h2>
        <a href={url('/about#whats-new')} class="meta link text-ink-3 hover:text-accent inline-flex items-center gap-1">
          <span>All updates ({p.news.length})</span>
          <span class="arrow">&rarr;</span>
        </a>
      </div>

      <ul class="divide-y divide-rule border-t border-b border-rule">
        {p.news.slice(0, siteConfig.home.news).map((item) => (
          <li class="py-4 flex flex-col gap-1 sm:flex-row sm:items-baseline sm:gap-6">
            <span class="meta font-mono text-xs text-ink-3 shrink-0 sm:w-24">{item.date}</span>
            <p class="text-[0.9375rem] text-ink-2 leading-relaxed">{item.text}</p>
          </li>
        ))}
      </ul>
    </section>
  )}

  <!-- Selected insights -->
  <section class="wrap py-16 md:py-24 border-b border-rule">
    <div class="flex flex-col gap-2 md:flex-row md:items-baseline md:justify-between mb-8">
      <h2 class="h-section">Selected writing</h2>
      <a href={url('/insights')} class="meta link text-ink-3 hover:text-accent inline-flex items-center gap-1">
        <span>All articles ({allInsights.length})</span>
        <span class="arrow">&rarr;</span>
      </a>
    </div>

    <div>
      {featuredInsights.map((entry) => (
        <ArticleRow entry={entry} />
      ))}
    </div>
  </section>

  <!-- Memories preview -->
  <section class="wrap py-16 md:py-24">
    <div class="flex flex-col gap-2 md:flex-row md:items-baseline md:justify-between mb-10">
      <div>
        <h2 class="h-section">Memories archive</h2>
        <p class="mt-1 text-[0.875rem] text-ink-3 font-serif italic">Moments, places, and quiet evenings.</p>
      </div>
      <a href={url('/memories')} class="meta link text-ink-3 hover:text-accent inline-flex items-center gap-1">
        <span>Enter archive</span>
        <span class="arrow">&rarr;</span>
      </a>
    </div>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 md:grid-cols-3">
      {previewMemories.map((photo) => (
        <a
          href={url('/memories')}
          class="group block overflow-hidden rounded-[2px] border border-rule bg-paper-2 p-2 shadow-xs transition-all duration-300 hover:border-ink/30 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
        >
          <div class="overflow-hidden rounded-[1px] bg-paper aspect-[4/3]">
            <img
              src={url(photo.src)}
              alt={photo.alt}
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.02]"
            />
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Certificate Lightbox Modal -->
  <div
    id="cert-lightbox"
    class="fixed inset-0 z-50 hidden flex-col justify-between bg-ink/95 text-paper backdrop-blur-md transition-opacity duration-300 opacity-0"
    role="dialog"
    aria-modal="true"
    aria-label="Certificate Lightbox"
  >
    <div class="flex items-center justify-between px-6 py-4 border-b border-paper/10">
      <div class="font-mono text-xs text-paper/70 tracking-widest">
        <span id="cert-lb-counter">01 / 03</span>
      </div>
      <button
        type="button"
        id="cert-lb-close"
        class="text-paper/70 hover:text-paper text-sm font-mono tracking-wider p-2 transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent"
        aria-label="Close certificate view"
      >
        [CLOSE ESC]
      </button>
    </div>

    <div class="relative flex-1 flex items-center justify-center p-4 sm:p-8 overflow-hidden select-none" id="cert-lb-stage">
      <button
        type="button"
        id="cert-lb-prev"
        class="absolute left-4 top-1/2 -translate-y-1/2 p-3 text-paper/50 hover:text-paper font-mono text-lg transition-colors z-10 focus-visible:outline-none"
        aria-label="Previous certificate"
      >
        &larr;
      </button>

      <img
        id="cert-lb-img"
        src=""
        alt=""
        class="max-h-[85vh] max-w-[92vw] object-contain rounded-[2px] shadow-2xl transition-transform duration-300"
      />

      <button
        type="button"
        id="cert-lb-next"
        class="absolute right-4 top-1/2 -translate-y-1/2 p-3 text-paper/50 hover:text-paper font-mono text-lg transition-colors z-10 focus-visible:outline-none"
        aria-label="Next certificate"
      >
        &rarr;
      </button>
    </div>
  </div>
</Base>

<script>
  // 1. Horizontal scroll shelf for Certifications
  const certTrack = document.getElementById('cert-scroll-track');
  const certScrollPrev = document.getElementById('cert-scroll-prev') as HTMLButtonElement | null;
  const certScrollNext = document.getElementById('cert-scroll-next') as HTMLButtonElement | null;

  function updateCertScrollButtons() {
    if (!certTrack) return;
    const maxScroll = certTrack.scrollWidth - certTrack.clientWidth;
    if (certScrollPrev) certScrollPrev.disabled = certTrack.scrollLeft <= 2;
    if (certScrollNext) certScrollNext.disabled = certTrack.scrollLeft >= maxScroll - 2;
  }

  certScrollPrev?.addEventListener('click', () => {
    certTrack?.scrollBy({ left: -Math.max(260, certTrack.clientWidth * 0.6), behavior: 'smooth' });
  });

  certScrollNext?.addEventListener('click', () => {
    certTrack?.scrollBy({ left: Math.max(260, certTrack.clientWidth * 0.6), behavior: 'smooth' });
  });

  certTrack?.addEventListener('scroll', updateCertScrollButtons, { passive: true });
  window.addEventListener('resize', updateCertScrollButtons);
  window.addEventListener('load', updateCertScrollButtons);
  updateCertScrollButtons();

  // 2. Fullscreen Lightbox for Certifications
  const lightbox = document.getElementById('cert-lightbox');
  const lbImg = document.getElementById('cert-lb-img') as HTMLImageElement;
  const lbCounter = document.getElementById('cert-lb-counter');
  const lbClose = document.getElementById('cert-lb-close');
  const lbPrev = document.getElementById('cert-lb-prev');
  const lbNext = document.getElementById('cert-lb-next');
  const lbStage = document.getElementById('cert-lb-stage');

  const triggers = Array.from(document.querySelectorAll<HTMLElement>('.cert-trigger'));
  let currentIndex = 0;

  const items = triggers.map((el) => ({
    src: el.dataset.certSrc || '',
    alt: el.dataset.certAlt || '',
  }));

  function openCertLightbox(index: number) {
    if (!lightbox || !lbImg || items.length === 0) return;
    currentIndex = (index + items.length) % items.length;
    const item = items[currentIndex]!;

    lbImg.src = item.src;
    lbImg.alt = item.alt;

    if (lbCounter) {
      const cur = String(currentIndex + 1).padStart(2, '0');
      const total = String(items.length).padStart(2, '0');
      lbCounter.textContent = `${cur} / ${total}`;
    }

    lightbox.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
    requestAnimationFrame(() => {
      lightbox.classList.remove('opacity-0');
      lightbox.classList.add('opacity-100');
    });
  }

  function closeCertLightbox() {
    if (!lightbox) return;
    lightbox.classList.remove('opacity-100');
    lightbox.classList.add('opacity-0');
    document.body.style.overflow = '';
    setTimeout(() => {
      lightbox.classList.add('hidden');
    }, 300);
  }

  triggers.forEach((trigger, idx) => {
    trigger.addEventListener('click', () => openCertLightbox(idx));
  });

  lbClose?.addEventListener('click', closeCertLightbox);
  lbNext?.addEventListener('click', () => openCertLightbox(currentIndex + 1));
  lbPrev?.addEventListener('click', () => openCertLightbox(currentIndex - 1));

  lbStage?.addEventListener('click', (e) => {
    if (e.target === lbStage) closeCertLightbox();
  });

  window.addEventListener('keydown', (e) => {
    if (!lightbox || lightbox.classList.contains('hidden')) return;
    if (e.key === 'Escape') closeCertLightbox();
    if (e.key === 'ArrowRight') openCertLightbox(currentIndex + 1);
    if (e.key === 'ArrowLeft') openCertLightbox(currentIndex - 1);
  });
</script>
