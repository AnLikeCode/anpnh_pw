---
import Base from '../../layouts/Base.astro';
import { getPage, url } from '../../lib/site';
import { getMemoryPhotos } from '../../lib/memories';

const page = await getPage('memories');
const photos = getMemoryPhotos();
---

<Base title={page?.data.title || 'Memories'} description={page?.data.description}>
  <div class="wrap py-12 md:py-20">
    <!-- Editorial Header -->
    <header class="mb-12 border-b border-rule pb-8">
      <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
        <div>
          <p class="meta text-accent mb-2 tracking-wider">PHOTOGRAPHY ARCHIVE</p>
          <h1 class="text-3xl font-medium tracking-tight text-ink md:text-5xl">
            {page?.data.title || 'Memories'}
          </h1>
          <p class="mt-3 font-serif italic text-base md:text-lg text-ink-2 max-w-[55ch] leading-relaxed">
            {page?.data.intro || 'A visual archive of prints and moments.'}
          </p>
        </div>

        <!-- View Controls & Metadata -->
        <div class="flex flex-wrap items-center gap-4 text-xs font-mono text-ink-3">
          <span>{photos.length} prints</span>
          <span class="text-rule-strong">/</span>
          <div class="inline-flex rounded-[3px] border border-rule p-0.5 bg-paper-2" role="group" aria-label="View mode">
            <button
              type="button"
              id="btn-masonry"
              class="px-2.5 py-1 text-xs rounded-[2px] transition-colors duration-200 bg-paper text-ink font-medium shadow-xs"
              data-view="masonry"
            >
              Wall Grid
            </button>
            <button
              type="button"
              id="btn-curated"
              class="px-2.5 py-1 text-xs rounded-[2px] transition-colors duration-200 text-ink-3 hover:text-ink"
              data-view="curated"
            >
              Curated Flow
            </button>
          </div>
        </div>
      </div>
    </header>

    <!-- 1. MASONRY GRID (Default Wall View) -->
    <div id="view-masonry-container" class="columns-1 sm:columns-2 lg:columns-3 gap-6 md:gap-8 [column-fill:_balance]">
      {
        photos.map((item, index) => (
          <figure class="break-inside-avoid mb-6 md:mb-8 group" data-index={index}>
            <div
              class="photo-trigger cursor-zoom-in overflow-hidden rounded-[2px] border border-rule bg-paper-2 p-2 shadow-xs transition-all duration-300 group-hover:border-ink/30"
              data-photo-src={url(item.src)}
              data-photo-alt={item.alt}
              data-photo-index={index}
            >
              <div class="overflow-hidden rounded-[1px] bg-paper">
                <img
                  src={url(item.src)}
                  alt={item.alt}
                  loading={index < 4 ? 'eager' : 'lazy'}
                  decoding="async"
                  class="w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.015]"
                />
              </div>
            </div>
          </figure>
        ))
      }
    </div>

    <!-- 2. CURATED ARTISTIC FLOW (Minimalist Connected Gallery Wire) -->
    <div id="view-curated-container" class="hidden relative pt-4 pb-10 px-4 sm:px-6 md:px-8">
      <!-- Continuous Minimalist SVG Wire -->
      <svg
        id="curated-wire-svg"
        class="pointer-events-none absolute inset-0 w-full h-full z-10 overflow-visible"
        aria-hidden="true"
      >
        <!-- Subtle architectural connector rail between rows -->
        <path
          id="curated-rail-path"
          d=""
          fill="none"
          stroke="var(--color-rule-strong)"
          stroke-width="1"
          stroke-dasharray="3 3"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        <!-- Main taut catenary wire across photo anchors -->
        <path
          id="curated-wire-path"
          d=""
          fill="none"
          stroke="var(--color-rule-strong)"
          stroke-width="1.15"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-8 md:gap-x-10 gap-y-12 md:gap-y-14 items-start">
        {
          photos.map((item, index) => {
            // Subtle, refined drop lengths (px) & barely-there natural tilt (deg)
            const cordHeights = [28, 38, 32, 36, 26, 40];
            const tilts = [-0.55, 0.45, -0.35, 0.5, -0.4, 0.4];
            const cordH = cordHeights[index % cordHeights.length];
            const tilt = tilts[index % tilts.length];

            return (
              <figure
                class="hanging-slot relative flex flex-col items-center group select-none"
                data-index={index}
                style={`--resting-tilt: ${tilt}deg;`}
              >
                {/* Top wire anchor dot */}
                <div
                  class="wire-anchor relative z-20 w-[6px] h-[6px] rounded-full bg-ink-3/80 ring-[2px] ring-paper transition-colors duration-300 group-hover:bg-accent"
                  aria-hidden="true"
                />

                {/* Suspended Print Assembly */}
                <div class="hanging-unit flex flex-col items-center max-w-full">
                  {/* Fine vertical thread */}
                  <div
                    class="w-px bg-rule-strong transition-colors duration-300 group-hover:bg-accent/80"
                    style={`height: ${cordH}px;`}
                    aria-hidden="true"
                  />

                  {/* Minimalist gallery clip tab */}
                  <div
                    class="relative z-10 -mb-px text-rule-strong group-hover:text-ink/30 transition-colors duration-300"
                    aria-hidden="true"
                  >
                    <svg width="22" height="10" viewBox="0 0 22 10" fill="none" class="block">
                      <path
                        d="M 2,10 L 3.8,2.8 C 4.2,1.4 5.4,0.6 7,0.6 L 15,0.6 C 16.6,0.6 17.8,1.4 18.2,2.8 L 20,10 Z"
                        fill="var(--color-paper-2)"
                        stroke="currentColor"
                        stroke-width="1"
                      />
                      <circle
                        cx="11"
                        cy="4.8"
                        r="1.6"
                        fill="var(--color-paper)"
                        stroke="currentColor"
                        stroke-width="0.9"
                      />
                    </svg>
                  </div>

                  {/* Framed Print: wraps natural aspect ratio with balanced visual height */}
                  <div
                    class="photo-trigger inline-block max-w-full cursor-zoom-in overflow-hidden rounded-[3px] border border-rule bg-paper-2 p-2 shadow-xs transition-all duration-300 group-hover:border-ink/30"
                    data-photo-src={url(item.src)}
                    data-photo-alt={item.alt}
                    data-photo-index={index}
                  >
                    <div class="overflow-hidden rounded-[1px] bg-paper">
                      <img
                        src={url(item.src)}
                        alt={item.alt}
                        loading={index < 4 ? 'eager' : 'lazy'}
                        decoding="async"
                        class="curated-photo-img w-auto h-auto max-h-[230px] sm:max-h-[240px] md:max-h-[250px] max-w-full block mx-auto transition-transform duration-500 ease-out group-hover:scale-[1.015]"
                      />
                    </div>
                  </div>
                </div>
              </figure>
            );
          })
        }
      </div>
    </div>
  </div>

  <!-- FULLSCREEN LIGHTBOX MODAL -->
  <div
    id="lightbox"
    class="fixed inset-0 z-50 hidden flex-col justify-between bg-ink/95 text-paper backdrop-blur-md transition-opacity duration-300 opacity-0"
    role="dialog"
    aria-modal="true"
    aria-label="Photo Lightbox"
  >
    <!-- Top Bar -->
    <div class="flex items-center justify-between px-6 py-4 border-b border-paper/10">
      <div class="font-mono text-xs text-paper/70 tracking-widest">
        <span id="lb-counter">01 / 01</span>
      </div>
      <button
        type="button"
        id="lb-close"
        class="text-paper/70 hover:text-paper text-sm font-mono tracking-wider p-2 transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent"
        aria-label="Close exhibition view"
      >
        [CLOSE ESC]
      </button>
    </div>

    <!-- Center Stage Photograph -->
    <div class="relative flex-1 flex items-center justify-center p-4 sm:p-8 overflow-hidden select-none" id="lb-stage">
      <button
        type="button"
        id="lb-prev"
        class="absolute left-4 top-1/2 -translate-y-1/2 p-3 text-paper/50 hover:text-paper font-mono text-lg transition-colors z-10 focus-visible:outline-none"
        aria-label="Previous photograph"
      >
        &larr;
      </button>

      <img
        id="lb-img"
        src=""
        alt=""
        class="max-h-[85vh] max-w-[92vw] object-contain rounded-[2px] shadow-2xl transition-transform duration-300"
      />

      <button
        type="button"
        id="lb-next"
        class="absolute right-4 top-1/2 -translate-y-1/2 p-3 text-paper/50 hover:text-paper font-mono text-lg transition-colors z-10 focus-visible:outline-none"
        aria-label="Next photograph"
      >
        &rarr;
      </button>
    </div>
  </div>
</Base>

<script>
  // 1. View Mode Switcher & Continuous Wire Renderer
  const btnCurated = document.getElementById('btn-curated');
  const btnMasonry = document.getElementById('btn-masonry');
  const containerCurated = document.getElementById('view-curated-container');
  const containerMasonry = document.getElementById('view-masonry-container');
  const wirePath = document.getElementById('curated-wire-path');
  const railPath = document.getElementById('curated-rail-path');

  function updateCuratedWire() {
    if (!containerCurated || !wirePath || containerCurated.classList.contains('hidden')) return;

    const cRect = containerCurated.getBoundingClientRect();
    if (cRect.width === 0) return;

    const anchors = Array.from(containerCurated.querySelectorAll<HTMLElement>('.wire-anchor'));
    if (anchors.length === 0) return;

    const points = anchors.map((el) => {
      const r = el.getBoundingClientRect();
      return {
        x: r.left - cRect.left + r.width / 2,
        y: r.top - cRect.top + r.height / 2,
      };
    });

    // Group anchor points into horizontal rows based on Y proximity
    const rows: { x: number; y: number }[][] = [];
    for (const pt of points) {
      const lastRow = rows[rows.length - 1];
      if (!lastRow || Math.abs(pt.y - lastRow[0]!.y) > 28) {
        rows.push([pt]);
      } else {
        lastRow.push(pt);
      }
    }

    rows.forEach((row) => row.sort((a, b) => a.x - b.x));

    const leftRail = 4;
    const rightRail = Math.max(cRect.width - 4, leftRail + 20);

    let mainD = '';
    let railD = '';

    for (let r = 0; r < rows.length; r++) {
      const row = rows[r]!;
      const ordered = r % 2 === 0 ? row : [...row].reverse();
      const firstInRow = ordered[0]!;

      if (r === 0) {
        mainD += `M ${firstInRow.x.toFixed(1)},${firstInRow.y.toFixed(1)}`;
      } else {
        mainD += ` M ${firstInRow.x.toFixed(1)},${firstInRow.y.toFixed(1)}`;
      }

      // Taut, subtle catenary wire across anchors in the same row (matching reference image)
      for (let i = 0; i < ordered.length - 1; i++) {
        const a = ordered[i]!;
        const b = ordered[i + 1]!;
        const mx = (a.x + b.x) / 2;
        const my = (a.y + b.y) / 2 + 5.5;
        mainD += ` Q ${mx.toFixed(1)},${my.toFixed(1)} ${b.x.toFixed(1)},${b.y.toFixed(1)}`;
      }

      // Clean architectural rail linking the end of row r to the start of row r + 1
      if (r < rows.length - 1) {
        const endOfRow = ordered[ordered.length - 1]!;
        const nextRow = rows[r + 1]!;
        const nextOrdered = (r + 1) % 2 === 0 ? nextRow : [...nextRow].reverse();
        const startOfNext = nextOrdered[0]!;
        const onRightSide = r % 2 === 0;
        const railX = onRightSide ? rightRail : leftRail;
        const rad = 8;
        const dirX = onRightSide ? -1 : 1;

        railD += ` M ${endOfRow.x.toFixed(1)},${endOfRow.y.toFixed(1)}`;
        railD += ` L ${(railX + dirX * rad).toFixed(1)},${endOfRow.y.toFixed(1)}`;
        railD += ` Q ${railX.toFixed(1)},${endOfRow.y.toFixed(1)} ${railX.toFixed(1)},${(endOfRow.y + rad).toFixed(1)}`;
        railD += ` L ${railX.toFixed(1)},${(startOfNext.y - rad).toFixed(1)}`;
        railD += ` Q ${railX.toFixed(1)},${startOfNext.y.toFixed(1)} ${(railX + dirX * rad).toFixed(1)},${startOfNext.y.toFixed(1)}`;
        railD += ` L ${startOfNext.x.toFixed(1)},${startOfNext.y.toFixed(1)}`;
      }
    }

    wirePath.setAttribute('d', mainD);
    if (railPath) {
      railPath.setAttribute('d', railD);
    }
  }

  function setView(mode: 'curated' | 'masonry') {
    if (mode === 'curated') {
      containerCurated?.classList.remove('hidden');
      containerMasonry?.classList.add('hidden');
      btnCurated?.classList.add('bg-paper', 'text-ink', 'font-medium', 'shadow-xs');
      btnCurated?.classList.remove('text-ink-3');
      btnMasonry?.classList.remove('bg-paper', 'text-ink', 'font-medium', 'shadow-xs');
      btnMasonry?.classList.add('text-ink-3');
      requestAnimationFrame(() => updateCuratedWire());
    } else {
      containerCurated?.classList.add('hidden');
      containerMasonry?.classList.remove('hidden');
      btnMasonry?.classList.add('bg-paper', 'text-ink', 'font-medium', 'shadow-xs');
      btnMasonry?.classList.remove('text-ink-3');
      btnCurated?.classList.remove('bg-paper', 'text-ink', 'font-medium', 'shadow-xs');
      btnCurated?.classList.add('text-ink-3');
    }
  }

  btnCurated?.addEventListener('click', () => setView('curated'));
  btnMasonry?.addEventListener('click', () => setView('masonry'));

  if (containerCurated) {
    const ro = new ResizeObserver(() => {
      requestAnimationFrame(() => updateCuratedWire());
    });
    ro.observe(containerCurated);

    containerCurated.querySelectorAll<HTMLImageElement>('img.curated-photo-img').forEach((img) => {
      if (!img.complete) {
        img.addEventListener('load', () => requestAnimationFrame(() => updateCuratedWire()), { once: true });
      }
    });
  }
  window.addEventListener('resize', () => requestAnimationFrame(() => updateCuratedWire()));

  // 2. Fullscreen Lightbox logic
  const lightbox = document.getElementById('lightbox');
  const lbImg = document.getElementById('lb-img') as HTMLImageElement;
  const lbCounter = document.getElementById('lb-counter');
  const lbClose = document.getElementById('lb-close');
  const lbPrev = document.getElementById('lb-prev');
  const lbNext = document.getElementById('lb-next');
  const lbStage = document.getElementById('lb-stage');

  const triggers = Array.from(document.querySelectorAll<HTMLElement>('.photo-trigger'));
  let currentIndex = 0;

  // Deduplicate triggers by source
  const uniqueItems: { src: string; alt: string }[] = [];
  const seen = new Set<string>();

  triggers.forEach((el) => {
    const src = el.dataset.photoSrc || '';
    if (!seen.has(src)) {
      seen.add(src);
      uniqueItems.push({
        src,
        alt: el.dataset.photoAlt || '',
      });
    }
  });

  function openLightbox(index: number) {
    if (!lightbox || !lbImg || uniqueItems.length === 0) return;
    currentIndex = (index + uniqueItems.length) % uniqueItems.length;
    const item = uniqueItems[currentIndex]!;

    lbImg.src = item.src;
    lbImg.alt = item.alt;

    if (lbCounter) {
      const cur = String(currentIndex + 1).padStart(2, '0');
      const total = String(uniqueItems.length).padStart(2, '0');
      lbCounter.textContent = `${cur} / ${total}`;
    }

    lightbox.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
    requestAnimationFrame(() => {
      lightbox.classList.remove('opacity-0');
      lightbox.classList.add('opacity-100');
    });
  }

  function closeLightbox() {
    if (!lightbox) return;
    lightbox.classList.remove('opacity-100');
    lightbox.classList.add('opacity-0');
    document.body.style.overflow = '';
    setTimeout(() => {
      lightbox.classList.add('hidden');
    }, 300);
  }

  function nextPhoto() {
    openLightbox(currentIndex + 1);
  }

  function prevPhoto() {
    openLightbox(currentIndex - 1);
  }

  // Attach click events
  triggers.forEach((trigger) => {
    trigger.addEventListener('click', () => {
      const src = trigger.dataset.photoSrc || '';
      const idx = uniqueItems.findIndex((item) => item.src === src);
      openLightbox(idx >= 0 ? idx : 0);
    });
  });

  lbClose?.addEventListener('click', closeLightbox);
  lbNext?.addEventListener('click', nextPhoto);
  lbPrev?.addEventListener('click', prevPhoto);

  // Close when clicking directly on the stage background
  lbStage?.addEventListener('click', (e) => {
    if (e.target === lbStage) closeLightbox();
  });

  // Keyboard navigation
  window.addEventListener('keydown', (e) => {
    if (!lightbox || lightbox.classList.contains('hidden')) return;
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowRight') nextPhoto();
    if (e.key === 'ArrowLeft') prevPhoto();
  });
</script>

<style>
  .hanging-slot {
    perspective: 900px;
  }

  .hanging-unit {
    transform-origin: 50% -3px;
    transform: rotateZ(var(--resting-tilt, 0deg));
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }

  .hanging-slot:hover .hanging-unit {
    transform: rotateZ(0deg) rotateX(2.5deg) translateY(-1px);
  }

  @media (prefers-reduced-motion: reduce) {
    .hanging-unit,
    .hanging-slot:hover .hanging-unit {
      transform: none;
      transition: none;
    }
  }
</style>
