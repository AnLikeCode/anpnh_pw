---
import Base from '../../layouts/Base.astro';
import MemoryCard from '../../components/memories/MemoryCard.astro';
import { getPage, published } from '../../lib/site';

const page = await getPage('memories');
const entries = await published('memories');
---

<Base title={page?.data.title || 'Memories'} description={page?.data.description}>
  <div class="wrap py-12 md:py-20">
    <header class="mb-14 border-b border-rule pb-10">
      <h1 class="text-3xl font-medium tracking-tight text-ink md:text-4xl">
        {page?.data.title || 'Memories'}
      </h1>
      {page?.data.intro && (
        <p class="mt-4 font-serif italic text-lg md:text-xl text-ink-2 max-w-[65ch] leading-relaxed">
          {page.data.intro}
        </p>
      )}
    </header>

    <!-- Staggered editorial visual archive (Pinterest moodboard inspired, preserving aspect ratios) -->
    <div class="columns-1 sm:columns-2 lg:columns-3 gap-8 [column-fill:_balance]">
      {entries.map((entry) => (
        <MemoryCard entry={entry} />
      ))}
    </div>
  </div>
</Base>
