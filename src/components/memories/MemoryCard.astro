---
import type { CollectionEntry } from 'astro:content';
import { formatDate, url } from '../../lib/site';

interface Props {
  entry: CollectionEntry<'memories'>;
  class?: string;
}

const { entry, class: className } = Astro.props;
const d = entry.data;
const href = url('/memories');
---

<article class:list={['group block break-inside-avoid mb-10', className]}>
  <a href={href} class="block focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent">
    <div class="overflow-hidden rounded-[2px] bg-paper-2 border border-rule">
      <img
        src={url(d.cover.src)}
        alt={d.cover.alt}
        loading="lazy"
        decoding="async"
        class="w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.015]"
      />
    </div>

    <div class="mt-3.5 space-y-1">
      <div class="flex items-baseline justify-between gap-2">
        <h3 class="text-[1.0625rem] font-medium tracking-[-0.01em] text-ink group-hover:text-accent transition-colors">
          {d.title}
        </h3>
        {d.sample && <span class="sample-tag shrink-0">example</span>}
      </div>

      <p class="font-serif italic text-[0.9375rem] text-ink-2 leading-relaxed">
        {d.caption}
      </p>

      <div class="meta pt-1 flex flex-wrap items-center gap-x-2 text-ink-3">
        <time datetime={d.date.toISOString()}>{formatDate(d.date)}</time>
        {d.location && (
          <>
            <span class="text-rule-strong">/</span>
            <span>{d.location}</span>
          </>
        )}
      </div>
    </div>
  </a>
</article>
