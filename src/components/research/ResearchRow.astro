---
import type { CollectionEntry } from 'astro:content';
import { formatMonthYear, kindLabel, statusLabel, url } from '../../lib/site';

interface Props {
  entry: CollectionEntry<'research'>;
}

const { entry } = Astro.props;
const d = entry.data;
const href = url(`/research/${entry.id}`);
const isSelfAuthor = (name: string) => /\bAn\b/i.test(name);
---

<article class="group border-b border-rule py-6 transition-colors duration-200">
  <div class="flex flex-col gap-2 md:flex-row md:items-baseline md:justify-between">
    <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
      <h3 class="text-[1.0625rem] font-medium tracking-[-0.01em]">
        <a href={href} class="quiet text-ink hover:text-accent">
          {d.title}
        </a>
      </h3>
      {d.sample && <span class="sample-tag">example</span>}
    </div>
    <div class="meta shrink-0">
      <span>{formatMonthYear(d.date)}</span>
    </div>
  </div>

  {d.authors && d.authors.length > 0 && (
    <p class="mt-1.5 text-[0.875rem] text-ink-2">
      {d.authors.map((author, idx) => (
        <>
          {isSelfAuthor(author) ? (
            <strong class="font-semibold text-ink">{author}</strong>
          ) : (
            <span>{author}</span>
          )}
          {idx < d.authors.length - 1 ? ', ' : ''}
        </>
      ))}
    </p>
  )}

  <p class="mt-2 text-[0.9375rem] text-ink-2 max-w-[65ch]">
    {d.summary}
  </p>

  <div class="meta mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 text-ink-3">
    <span>{kindLabel[d.kind] || d.kind}</span>
    {(statusLabel[d.status] || d.status).toLowerCase() !== (kindLabel[d.kind] || d.kind).toLowerCase() && (
      <>
        <span class="text-rule-strong">/</span>
        <span class="capitalize">{statusLabel[d.status] || d.status}</span>
      </>
    )}
    {d.venue && (
      <>
        <span class="text-rule-strong">/</span>
        <span>{d.venue}</span>
      </>
    )}
    {d.links && d.links.length > 0 && (
      <>
        <span class="text-rule-strong">/</span>
        <span class="inline-flex items-center gap-3">
          {d.links.map((link) => (
            <a
              href={url(link.url)}
              target="_blank"
              rel="noopener noreferrer"
              class="link text-ink-2 hover:text-accent inline-flex items-center gap-0.5"
            >
              <span>{link.label}</span>
              <span class="arrow-ne">&nearr;</span>
            </a>
          ))}
        </span>
      </>
    )}
  </div>
</article>
