---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { siteConfig } from '../site.config';
import { getProfile, url } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  noindex?: boolean;
}

const { title, description, image, type = 'website', publishedTime, noindex = false } = Astro.props;
const profile = await getProfile();
const name = profile.data.name;

const fullTitle = title ? `${title} | ${name}` : `${name} | ${profile.data.identity}`;
const desc = description || profile.data.summary || siteConfig.description;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(url(image), Astro.site).toString() : undefined;
const rss = url('/rss.xml');
---

<!doctype html>
<html lang={siteConfig.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    <link rel="alternate" type="application/rss+xml" title={`${siteConfig.rssTitle} | ${name}`} href={rss} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111111" media="(prefers-color-scheme: dark)" />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={name} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {type === 'article' && <meta property="article:author" content={name} />}
    <slot name="head" />
  </head>
  <body class="flex min-h-[100dvh] flex-col bg-paper text-ink">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:bg-paper focus:px-3 focus:py-2 focus:text-sm"
      >Skip to content</a
    >
    <Header name={name} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer profile={profile.data} />
  </body>
</html>
